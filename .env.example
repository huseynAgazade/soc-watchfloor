# soc-watchfloor — copy to .env and fill in. NEVER commit a filled-in .env.

# --- Postgres (persistent volume) ---
POSTGRES_DB=watchfloor
POSTGRES_USER=watchfloor
POSTGRES_PASSWORD=change-me

# --- Initial admin (seeded once on an empty DB) ---
# Leave the password empty to have a random one generated and printed once to the
# core log (it must be changed at first sign-in). Every other account is created
# by an admin in Users & access, with a password the admin sets.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Organisation timezone (reporting periods, "today", shift windows) ---
ORG_TIMEZONE=Asia/Dubai

# --- Splunk (read-only) — the SOAR/SLA connector authenticates with these ---
SPLUNK_BASE_URL=https://siem.example
SPLUNK_USERNAME=socadmin
# Prefer a token (Splunk: Settings -> Tokens). If empty, the password is used:
SPLUNK_TOKEN=
SPLUNK_PASSWORD=
SPLUNK_APP=search
SPLUNK_VERIFY_SSL=false

# --- Cookies: set true only when serving over HTTPS ---
COOKIE_SECURE=false

# --- Splunk SOAR (read-only) — roster connector ---
# The SOAR the roster and the assistant read (the same instance Splunk's
# restsoar "soc_soar" uses for SLA). Token: an automation user on that SOAR.
SPLUNK_SOAR_URL=https://soar.example
SPLUNK_SOAR_API=
SOAR_VERIFY_SSL=false
ROSTER_LIST_NAME=monthly_shift_roster   # found by name; list ids differ between SOAR instances

# --- SLA/L1 Splunk (token against the SIEM head; robust, no password) ---
SPLUNK_SLA_URL=https://10.0.0.11:8089
SPLUNK_SLA_TOKEN=

# --- Assistant (Claude via Anthropic) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
# Limits (defaults shown): per question, and per user
# ASSISTANT_MAX_MESSAGE_CHARS=4000
# ASSISTANT_MAX_HISTORY_TURNS=20
# ASSISTANT_MAX_TOOL_TURNS=8
# ASSISTANT_MAX_TOOL_CALLS=12
# ASSISTANT_TIMEOUT_SECONDS=120
# ASSISTANT_REQUESTS_PER_MINUTE=6
# ASSISTANT_REQUESTS_PER_DAY=200
