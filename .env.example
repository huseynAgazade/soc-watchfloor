# soc-watchfloor — copy to .env and fill in. NEVER commit a filled-in .env.

# --- Postgres (persistent volume) ---
POSTGRES_DB=watchfloor
POSTGRES_USER=watchfloor
POSTGRES_PASSWORD=change-me

# --- Initial admin (seeded once on an empty DB; change the password at first login) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme-admin-1234

# --- Splunk (read-only) — the SOAR/SLA connector authenticates with these ---
SPLUNK_BASE_URL=https://siem.example
SPLUNK_USERNAME=socadmin
# Prefer a token (Splunk: Settings -> Tokens). If empty, the password is used:
SPLUNK_TOKEN=
SPLUNK_PASSWORD=
SPLUNK_APP=search
SPLUNK_VERIFY_SSL=false

# --- Cookies: set true only when serving over HTTPS ---
COOKIE_SECURE=false

# --- Splunk SOAR (read-only) — roster connector ---
SPLUNK_SOAR_URL=https://10.0.0.12:8443
SPLUNK_SOAR_API=
SOAR_VERIFY_SSL=false
ROSTER_LIST_ID=43

# --- SLA/L1 Splunk (token against the SIEM head; robust, no password) ---
SPLUNK_SLA_URL=https://10.0.0.11:8089
SPLUNK_SLA_TOKEN=

# --- Assistant (Claude via Anthropic) ---
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5
