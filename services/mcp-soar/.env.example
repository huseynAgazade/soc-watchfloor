# mcp-soar — Splunk connection (read-only). Never commit a filled-in .env.
SPLUNK_BASE_URL=https://siem.example
SPLUNK_USERNAME=socadmin
# Prefer a Splunk auth token in production (Settings -> Tokens):
SPLUNK_TOKEN=
# Password fallback (used only if SPLUNK_TOKEN is empty):
SPLUNK_PASSWORD=
SPLUNK_APP=search
SPLUNK_VERIFY_SSL=false
