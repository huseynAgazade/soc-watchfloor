# mcp-soar-chat — the SOAR MCP server (YOUR_ORG/splunk-soar-mcp) + exec bridge.
# The upstream server is read-only and private; the core's authorization proxy is
# the security boundary in front of it.
SPLUNK_SOAR_URL=https://10.0.0.12:8443
SPLUNK_SOAR_API=
SOAR_MCP_MODE=readonly
SOAR_MCP_VERIFY_SSL=false
